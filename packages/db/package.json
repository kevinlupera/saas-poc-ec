{
  "name": "@saas/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./tenant": "./src/tenant.ts",
    "./rls": "./src/rls.ts"
  },
  "description": "Driven adapter: Drizzle + Postgres client, schema and migrations.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:app-role": "node src/setup-app-role.ts",
    "test:db": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
