{
  "name": "saas-poc-ec",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @saas/api dev",
    "dev:web": "pnpm --filter @saas/web dev",
    "build": "pnpm -r run build",
    "test:db": "pnpm --filter @saas/db test:db",
    "e2e:tenant": "bash scripts/e2e-tenant.sh",
    "e2e:oauth": "bash scripts/e2e-oauth.sh",
    "e2e:auth": "bash scripts/e2e-auth.sh",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:api": "node scripts/check-api-contract.mjs",
    "typecheck": "pnpm --filter @saas/api run types && pnpm -r run typecheck",
    "check": "pnpm check:boundaries && pnpm check:tokens && pnpm check:api && pnpm typecheck && pnpm lint",
    "lint": "eslint",
    "check:tokens": "pnpm --filter @saas/tokens test",
    "test": "pnpm -r --if-present run test && node --test scripts/*.test.mjs",
    "mcp:inspect": "pnpm dlx @modelcontextprotocol/inspector@2.13.0"
  },
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "lefthook": "2.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
