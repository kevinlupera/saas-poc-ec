# Required, 32+ chars. Generate one: openssl rand -base64 32
NITRO_AUTH_SECRET=
# Runtime role saas_app (created by `pnpm --filter @saas/db db:app-role`), NOT the owner: the owner bypasses RLS.
# On Neon use the pooled (-pooler) string of the saas_app role with ?sslmode=require
NITRO_DATABASE_URL=postgres://saas_app:saas_app@localhost:5433/saas
NITRO_AUTH_BASE_URL=http://localhost:3001
NITRO_MCP_RESOURCE=http://localhost:3001/mcp
NITRO_WEB_ORIGIN=http://localhost:3000

# Email (server only). Production REQUIRES both Resend values, or the API refuses to start.
# Without NITRO_RESEND_API_KEY, non-production sends over plain SMTP to Mailpit (docker compose up -d):
# inbox at http://localhost:8025. NITRO_EMAIL_FROM defaults to no-reply@localhost for SMTP.
NITRO_RESEND_API_KEY=
NITRO_EMAIL_FROM=
NITRO_SMTP_HOST=localhost
NITRO_SMTP_PORT=1025
# Google sign-in (server only): both or neither; empty = Google disabled.
# Google Cloud redirect URI: http://localhost:3001/api/auth/callback/google
NITRO_GOOGLE_CLIENT_ID=
NITRO_GOOGLE_CLIENT_SECRET=
